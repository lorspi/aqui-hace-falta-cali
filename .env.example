# Plantilla de Variables de Entorno para Aquí Hace Falta
# Copiar a .env.local para desarrollo local

# URL de la API de Supabase
VITE_SUPABASE_URL=https://<tu-proyecto-supabase>.supabase.co

# Llave Anónima Pública de Supabase (Anon Key / Publishable Key)
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# Nombre del Entorno (development | production)
VITE_ENV_NAME=development
