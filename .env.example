# --- DEVELOPMENT (set automatically by `npx convex dev`) ---
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# VITE_CONVEX_URL=https://your-dev-deployment.convex.cloud

# --- PRODUCTION (set after running `npx convex deploy`) ---
# Create a .env.production file with:
# VITE_CONVEX_URL=https://your-prod-deployment.convex.cloud

# --- CLOUDFLARE TURNSTILE ---
# Get your keys from: https://dash.cloudflare.com/?to=/:account/turnstile
# VITE_TURNSTILE_SITE_KEY=your-site-key
# TURNSTILE_SECRET_KEY=your-secret-key (set in Convex env vars)
